# Django Configuration
SECRET_KEY=your_secret_key_here
DEBUG=True

# Database Configuration
POSTGRES_DB=uniqakntu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
